# ============================================================================
# Multi-Agent Orchestrator — configuration template
#
# Copy this file to `.env` and fill in your values:
#     Copy-Item .env.example .env
#
# `.env` is git-ignored. NEVER commit real API keys.
# Every value here can be overridden at runtime from the Settings panel, except
# the API keys — those are read from this file only.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
# Bind to loopback only. This is a local-first application; do not expose it.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------------
# DeepSeek — the Main Agent (planner / router / reviewer / final author)
# ---------------------------------------------------------------------------
# Required. Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Used only if you switch DEEPSEEK_MODEL / REASONING_MAIN to a reasoner model.
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT_S=300
DEEPSEEK_MAX_RETRIES=2

# Optional pricing in USD per 1,000,000 tokens. Leave blank and the UI shows
# "N/A" instead of a made-up cost — never hardcode prices here.
# DEEPSEEK_PRICE_INPUT=0.27
# DEEPSEEK_PRICE_OUTPUT=1.10

# ---------------------------------------------------------------------------
# Local MiniCPM5-2B via llama.cpp (llama-server)
# ---------------------------------------------------------------------------
# Start it with:
#   llama-server.exe -m <path>\MiniCPM5-2B-Q8_0.gguf --host 127.0.0.1 --port 8080 -c 16384 -ngl 99
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_NAME=MiniCPM5-2B
LOCAL_MODEL_API_KEY=local
LOCAL_MODEL_TIMEOUT_S=180
LOCAL_MODEL_MAX_RETRIES=2
LOCAL_MODEL_CONTEXT_WINDOW=16384

# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------
# Hard ceiling on agent steps per request. Prevents infinite delegation loops.
MAX_AGENT_STEPS=12
MAIN_AGENT_MAX_TOKENS=4096
WORKER_MAX_TOKENS=2048
MAIN_AGENT_TEMPERATURE=0.3
WORKER_TEMPERATURE=1.0
WORKER_TOP_P=0.95

# Reasoning policy per agent: none | low | medium | high
#   none   -> thinking disabled (cheapest, best for extraction/classification)
#   low    -> small thinking budget
#   medium -> moderate
#   high   -> large
REASONING_MAIN=medium
REASONING_EXTRACTOR=none
REASONING_SUMMARIZER=low
REASONING_CLASSIFIER=none
REASONING_REVIEWER=medium

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Set to false to force everything onto DeepSeek (useful for comparison).
ENABLE_LOCAL_WORKERS=true
# Whether the UI may show reasoning traces (they stay collapsed by default).
SHOW_REASONING=true
# Debug Mode: raw decisions, parse errors, retries, internal agent state.
DEBUG_MODE=false
STREAM_FINAL_ANSWER=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite by default. The file is created automatically.
# DATABASE_URL=sqlite+aiosqlite:///./data/multiagent.db
